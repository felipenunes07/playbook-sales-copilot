# Copy to .env (git-ignored). run.sh sources it. Never commit real keys.
# On Vercel, set the same names under Project Settings → Environment Variables.

# --- Jev (pick one) ---
# OpenRouter: real Jev on /api/alpha/decisions (typesafe/jev-1.13); also powers phrasing and call transcription.
# Takes priority over the other keys when set.
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# Official TypeSafe key (https://console.typesafe.ai/keys):
# TYPESAFE_API_KEY=ts_your_key_here
# jevmodel.org key (sk-…), 8 questions per request:
# JEVMODEL_API_KEY=sk-your_key_here

# Optional models on OpenRouter
# OPENROUTER_LLM_MODEL=qwen/qwen3.7-flash   (ou anthropic/claude-haiku-5.5, ~5x mais caro)
# OPENROUTER_STT_MODEL=openai/gpt-audio-mini
# Optional: Anthropic directly for tailored phrasing instead of OpenRouter
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- Access from outside this machine (required in production) ---
# Team password for the login page. Without it the copilot only opens on localhost.
# APP_PASSWORD=choose-a-long-password
# Signs login cookies and call-room links; any long random string, the same on every instance.
# APP_SECRET=a-long-random-string
# Or no login at all: anyone with the URL can use the copilot (and spend the API keys).
# OPEN_ACCESS=1

# --- Video call on serverless hosts (Vercel) ---
# Upstash Redis REST credentials (Vercel Marketplace → Upstash Redis adds these). Locally an in-memory queue is used.
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=…
# Optional TURN servers for networks that block peer-to-peer video (JSON list of RTCIceServer)
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Optional
# PORT=8000
# COPILOT_ECONOMY=1
# TYPESAFE_LOG_LEVEL=info
